# Copy to ~/.config/codex-control-plane/mcp-tunnel.env and set mode 0600.
# This file contains only nonsecret paths and routing identity. Never add the
# control-plane operator token or a Runtime API Key to it. Initialize the
# owner-private tunnel-client profile using the OpenAI Runtime API Key's file
# reference, and check it with `tunnel-client doctor --profile ... --explain`.
CONTROL_PLANE_TUNNEL_CLIENT=<absolute-path-to-linux-tunnel-client>
CONTROL_PLANE_TUNNEL_PROFILE=ubuntu-root-mcp
CONTROL_PLANE_TUNNEL_ID=<tunnel_id-for-ubuntu-root-mcp>
CONTROL_PLANE_MCP_BIND=127.0.0.1
CONTROL_PLANE_MCP_PORT=8766
# During the legacy canary, the Tunnel injects a scoped context grant. This is
# the only mode in which the header-file setting below may be present.
CONTROL_PLANE_MCP_AUTH_MODE=legacy_context_grant
# Separate owner-private regular file, mode 0400 or 0600, containing the full
# `Bearer <scoped-MCP-grant>` value. It is neither the operator token nor the
# OpenAI Runtime API Key. The launcher passes only this file reference to both
# request and discovery Authorization headers; it never reads the contents.
CONTROL_PLANE_MCP_AUTH_HEADER_FILE=<absolute-private-file-for-scoped-mcp-authorization>

# For account OAuth, set CONTROL_PLANE_MCP_AUTH_MODE=oauth_introspection and
# remove (do not leave blank) CONTROL_PLANE_MCP_AUTH_HEADER_FILE. The Tunnel
# must forward the OAuth token supplied by the client unchanged; its profile
# still owns only the Runtime API Key needed for the outbound Tunnel itself.
