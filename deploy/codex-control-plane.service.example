[Unit]
Description=Coding Tools Ubuntu Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/svhome/DEV/Codex-web
EnvironmentFile=%h/.config/codex-control-plane/control-plane.env
Environment=PYTHONPATH=/home/svhome/DEV/Codex-web/control-plane
ExecStart=/usr/bin/python3 -m control_plane
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
