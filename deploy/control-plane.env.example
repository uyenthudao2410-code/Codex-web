# Copy outside the release tree to
# ~/.config/codex-control-plane/control-plane.env, set mode 0600, and replace
# every <...> value. Do not commit the resulting file or place it in an archive.
# Before switching `current`, run `python3 deploy/control-plane-verify-release.py`
# against the extracted release directory and compare its content-free receipt
# to the selected manifest.
CONTROL_PLANE_DB=<absolute-state-directory>/control-plane.sqlite3
CONTROL_PLANE_BACKUP_DIR=<absolute-state-directory>/backups
CONTROL_PLANE_BIND=<private-tailnet-address>
CONTROL_PLANE_PORT=8765
# The OpenAI Tunnel receives this listener only; it must remain loopback and
# cannot share the Tailnet UI/node API bind above.
CONTROL_PLANE_MCP_BIND=127.0.0.1
CONTROL_PLANE_MCP_PORT=8766
CONTROL_PLANE_OPERATOR_TOKEN=<at-least-32-character-secret>
CONTROL_PLANE_DECLARED_SOURCE_REVISION=<exact-40-or-64-character-git-revision>
CONTROL_PLANE_EXPECTED_PACKAGE_SOURCE_SHA256=sha256:<64-lowercase-hex>
CONTROL_PLANE_WEB_ORIGIN=https://<private-control-plane-origin>
CONTROL_PLANE_WEB_SESSION_TTL_SECONDS=1800
CONTROL_PLANE_HEALTH_URL=https://<private-control-plane-origin>/healthz
# This asserts the deliberate maintenance state. Start at recovery during
# migration/canary; change it to open only after the explicit readiness gate.
# It observes admission and never changes it.
CONTROL_PLANE_HEALTH_EXPECTED_ADMISSION=recovery

# Configure the OpenAI Secure MCP Tunnel separately using
# deploy/control-plane-mcp-tunnel.env.example. Do not let its service load this
# file: the privileged operator token above is not a Tunnel credential.
