# Copy outside the release tree to
# ~/.config/codex-control-plane/control-plane.env, set mode 0600, and replace
# every <...> value. Do not commit the resulting file or place it in an archive.
# Before switching `current`, run `python3 deploy/control-plane-verify-release.py`
# against the extracted release directory and compare its content-free receipt
# to the selected manifest.
CONTROL_PLANE_DB=<absolute-state-directory>/control-plane.sqlite3
CONTROL_PLANE_BACKUP_DIR=<absolute-state-directory>/backups
CONTROL_PLANE_BIND=<private-tailnet-address>
CONTROL_PLANE_PORT=8765
# The OpenAI Tunnel receives this listener only; it must remain loopback and
# cannot share the Tailnet UI/node API bind above.
CONTROL_PLANE_MCP_BIND=127.0.0.1
CONTROL_PLANE_MCP_PORT=8766
# Explicitly select the historical grant mode until the separately configured
# OAuth provider and principal mapping have passed a candidate rollout.
# In oauth_introspection mode, configure every CONTROL_PLANE_MCP_OAUTH_* value
# below and use a matching mcp-tunnel.env with no static header-file setting.
CONTROL_PLANE_MCP_AUTH_MODE=legacy_context_grant
# OAuth account mode (the five values below are required together only when
# CONTROL_PLANE_MCP_AUTH_MODE=oauth_introspection). The credential file is an
# owner-private regular JSON file, mode 0400 or 0600, with exactly client_id
# and client_secret. It is not a Tunnel Runtime API Key and never belongs in
# this example's deployed secret file by copy/paste from chat.
# CONTROL_PLANE_MCP_OAUTH_RESOURCE=https://<canonical-openai-mcp-resource>
# CONTROL_PLANE_MCP_OAUTH_ISSUER=https://<oauth-issuer>
# CONTROL_PLANE_MCP_OAUTH_INTROSPECTION_URL=https://<oauth-issuer>/introspect
# CONTROL_PLANE_MCP_OAUTH_CREDENTIAL_FILE=<absolute-private-introspection-client-json>
# CONTROL_PLANE_MCP_OAUTH_SCOPE=control-plane.inventory
# Optional C3 candidate gate, valid only in oauth_introspection mode. Leave it
# absent in legacy_context_grant mode. `true` exposes only the independently
# policy-bounded read_file lane; it never enables write, shell, or a workspace
# path chosen by a remote client.
# CONTROL_PLANE_MCP_OAUTH_FILE_READ_ENABLED=false
# Optional C4 candidate gate, valid only when oauth_introspection mode and the
# C3 file-read candidate are both explicitly true. It exposes only the
# review-only request_permissions(request_patch/status) contract: approval is
# central evidence and never enables a write relay, shell, process launch,
# action dispatch, or Windows local policy.
# CONTROL_PLANE_MCP_OAUTH_PERMISSION_REQUESTS_ENABLED=false
# Trusted-workspace standing authority candidate: keep these commented until
# the exact IdP scope, node-local policy and Windows package/live gates pass.
# It removes per-patch owner review but does not remove task pinning, writer
# lease, generation fences, local OS permissions, or terminal receipts.
# CONTROL_PLANE_MCP_OAUTH_STANDING_WRITE_ENABLED=true
# CONTROL_PLANE_MCP_OAUTH_PATCH_WRITE_SCOPE=control-plane.patch
# CONTROL_PLANE_MCP_OAUTH_APPROVED_PATCH_ENABLED=false
# CONTROL_PLANE_MCP_OAUTH_EXEC_ENABLED=true
CONTROL_PLANE_OPERATOR_TOKEN=<at-least-32-character-secret>
CONTROL_PLANE_DECLARED_SOURCE_REVISION=<exact-40-or-64-character-git-revision>
CONTROL_PLANE_EXPECTED_PACKAGE_SOURCE_SHA256=sha256:<64-lowercase-hex>
CONTROL_PLANE_WEB_ORIGIN=https://<private-control-plane-origin>
CONTROL_PLANE_WEB_SESSION_TTL_SECONDS=1800
CONTROL_PLANE_HEALTH_URL=https://<private-control-plane-origin>/healthz
# This asserts the deliberate maintenance state. Start at recovery during
# migration/canary; change it to open only after the explicit readiness gate.
# It observes admission and never changes it.
CONTROL_PLANE_HEALTH_EXPECTED_ADMISSION=recovery

# Configure the OpenAI Secure MCP Tunnel separately using
# deploy/control-plane-mcp-tunnel.env.example. Do not let its service load this
# file: the privileged operator token above is not a Tunnel credential.
