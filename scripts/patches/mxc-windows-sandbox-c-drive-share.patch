+/// A restart may reclaim only the sandbox named by the prior daemon record.
+/// The daemon uses that record's process identities for orphan teardown, so a
+/// different sandbox's stale record must be refused before spawning it.
+fn ensure_start_daemon_identity(
+    prior: Option<&DaemonRecord>,
+    sandbox_id: &str,
+) -> Result<(), MxcError> {
+    if let Some(prior) = prior {
+        if prior.active_sandbox_id != sandbox_id {
+            return Err(MxcError::backend_unavailable(format!(
+                "daemon bookkeeping belongs to Windows Sandbox {}; refusing to start \
+                 {sandbox_id}. Stop/deprovision the recorded sandbox first.",
+                prior.active_sandbox_id
+            )));
+        }
+    }
+    Ok(())
+}
