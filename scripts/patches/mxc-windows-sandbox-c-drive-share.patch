+/// Translate a host working directory into the destination of the mapped
+/// folder that contains it. Unmapped paths remain unchanged for requests that
+/// intentionally use the guest's default current directory.
+pub(crate) fn guest_working_directory(
+    mapped_folders: &[MappedFolder],
+    host_working_directory: &str,
+) -> String {
+    if host_working_directory.is_empty() {
+        return String::new();
+    }
+
+    let candidate = std::fs::canonicalize(host_working_directory)
+        .map(|path| Path::new(&strip_verbatim_prefix(&path.to_string_lossy())).to_path_buf())
+        .unwrap_or_else(|_| Path::new(host_working_directory).to_path_buf());
+    for folder in mapped_folders {
+        let host_root = Path::new(&folder.host);
+        if let Ok(relative) = candidate.strip_prefix(host_root) {
+            return Path::new(&folder.sandbox)
+                .join(relative)
+                .to_string_lossy()
+                .into_owned();
+        }
+    }
+    host_working_directory.to_string()
+}
