[Unit]
Description=Verify Coding Tools control-plane health and backup freshness
After=codex-control-plane.service codex-control-plane-backup.service
Wants=codex-control-plane.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/codex-control-plane/control-plane.env
ExecStart=%h/.local/lib/codex-control-plane/current/deploy/control-plane-healthcheck.sh
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
