{
  "name": "web-mcp-assistant",
  "version": "0.3.4",
  "description": "Trợ lý desktop Windows giúp triển khai và quản lý Coding Tools MCP, OpenAI Tunnel và kết nối ChatGPT chỉ với 1 cú nhấp chuột.",
  "author": "3169657175",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "icon:build": "node scripts/generate-icon.js",
    "start": "electron .",
    "test": "node --test tests/*.test.js && node scripts/check-source-root-clean.js",
    "test:recovery:e2e": "node --test tests/integration/recovery-host-process.test.js",
    "test:mcp": "cd resources/coding-tools-mcp && python -m pytest tests",
    "test:all": "npm test && npm run test:mcp",
    "benchmark:routing": "cd resources/coding-tools-mcp && python -m benchmarks.routing_economics",
    "benchmark:activation": "cd resources/coding-tools-mcp && python -m benchmarks.runtime_activation",
    "probe:execution-hub": "node scripts/execution-hub-activation-probe.js",
    "canary:opencode-flash:preflight": "electron scripts/execution-hub-provider-canary.js --preflight",
    "canary:opencode-flash": "electron scripts/execution-hub-provider-canary.js",
    "audit:prod": "npm audit --omit=dev",
    "dist": "npm run icon:build && npm test && electron-builder --win nsis",
    "dist:dir": "npm run icon:build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.gptwebcodex.assistant",
    "productName": "Trợ lý Web MCP",
    "artifactName": "web-mcp-assistant-setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "renderer/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!coding-tools-mcp/benchmarks/reports/**",
          "!**/__pycache__/**",
          "!**/.pytest_cache/**",
          "!**/*.egg-info/**",
          "!**/.coding-tools/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      }
    ],
    "afterPack": "scripts/verify-packaged-resources.js",
    "win": {
      "icon": "electron/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Trợ lý Web MCP",
      "installerIcon": "electron/app-icon.ico",
      "uninstallerIcon": "electron/app-icon.ico",
      "installerHeaderIcon": "electron/app-icon.ico",
      "runAfterFinish": true
    }
  }
}
