{
  "name": "coding-tools-mcp",
  "version": "1.0.0",
  "description": "Windows Execution Hub để vận hành Coding Tools MCP, OpenAI Tunnel và kết nối ChatGPT.",
  "author": "3169657175",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "icon:build": "node scripts/generate-icon.js",
    "start": "node scripts/dev-ui-lifecycle.js start",
    "dev": "node scripts/dev-ui-lifecycle.js start",
    "dev:status": "node scripts/dev-ui-lifecycle.js status",
    "dev:control-center": "node scripts/dev-ui-lifecycle.js control-center",
    "dev:stop": "node scripts/dev-ui-lifecycle.js stop",
    "dev:replace": "node scripts/dev-ui-lifecycle.js replace",
    "dev:refresh": "node scripts/dev-ui-lifecycle.js refresh",
    "test": "node --test tests/*.test.js && node scripts/check-source-root-clean.js && node scripts/check-sensitive-tracked.js",
    "test:recovery:e2e": "node --test tests/integration/recovery-host-process.test.js",
    "test:recovery:packaged": "npm run dist:dir && node scripts/packaged-recovery-smoke.js",
    "recovery:supervisor:install": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File resources/recovery-supervisor/recovery-supervisor.ps1 -Action Install",
    "recovery:supervisor:status": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File resources/recovery-supervisor/recovery-supervisor.ps1 -Action Status",
    "recovery:supervisor:once": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File resources/recovery-supervisor/recovery-supervisor.ps1 -Action Once",
    "recovery:supervisor:uninstall": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File resources/recovery-supervisor/recovery-supervisor.ps1 -Action Uninstall",
    "test:mcp": "cd resources/coding-tools-mcp && python -m pytest tests",
    "test:all": "npm test && npm run test:mcp",
    "check:repository-secrets": "node scripts/check-sensitive-tracked.js",
    "test:repository-secrets": "node --test tests/check-sensitive-tracked.test.js",
    "check:coding-tools-history": "node scripts/check-sensitive-tracked.js && node scripts/check-coding-tools-history.js",
    "stage:coding-tools-delivery": "python scripts/stage-coding-tools-delivery.py",
    "archive:ledger": "python scripts/archive-ledger.py",
    "ledger:history": "python scripts/query-ledger-history.py list",
    "check:coding-tools-delivery": "node scripts/check-sensitive-tracked.js && python scripts/stage-coding-tools-delivery.py && node scripts/check-coding-tools-history.js --require-staged",
    "check:p5-readiness": "python resources/coding-tools-mcp/scripts/report_p4_readiness.py --workspace . --require-p5-ready",
    "plan:p5-treatment": "python resources/coding-tools-mcp/scripts/plan_p5_controlled_treatment.py --workspace .",
    "report:p5-baseline": "python resources/coding-tools-mcp/scripts/report_p5_baseline.py --workspace .",
    "report:ui-performance": "node scripts/report-ui-performance.js",
    "report:accepted-result-economics": "python resources/coding-tools-mcp/scripts/report_accepted_result_economics.py --workspace .",
    "benchmark:routing": "cd resources/coding-tools-mcp && python -m benchmarks.routing_economics",
    "benchmark:orchestration-tax": "cd resources/coding-tools-mcp && python -m benchmarks.orchestration_tax",
    "benchmark:activation": "cd resources/coding-tools-mcp && python -m benchmarks.runtime_activation",
    "benchmark:multilayer": "python tests/p4_eval_pack/run_multilayer_challenge_suite.py --repo-root .",
    "benchmark:multilayer:strict": "python tests/p4_eval_pack/run_multilayer_challenge_suite.py --repo-root . --strict-known-diagnostics",
    "benchmark:model-extreme:self-test": "python tests/model_eval_pack/run_model_extreme_suite.py --repo-root . --self-test",
    "probe:execution-hub": "node scripts/execution-hub-activation-probe.js",
    "canary:opencode-flash:preflight": "electron scripts/execution-hub-provider-canary.js --preflight",
    "canary:opencode-flash": "electron scripts/execution-hub-provider-canary.js",
    "audit:prod": "npm audit --omit=dev",
    "dist": "npm run icon:build && npm run test:all && node scripts/clean-dist.js && electron-builder --win nsis",
    "dist:dir": "npm run icon:build && node scripts/clean-dist.js && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.gptwebcodex.assistant",
    "productName": "Coding Tools MCP",
    "electronLanguages": [
      "en-US",
      "vi"
    ],
    "artifactName": "coding-tools-mcp-setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "renderer/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!coding-tools-mcp/tests/**",
          "!coding-tools-mcp/benchmarks/**",
          "!coding-tools-mcp/scripts/**",
          "!**/__pycache__/**",
          "!**/.pytest_cache/**",
          "!**/*.egg-info/**",
          "!**/.coding-tools/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      },
      {
        "from": "resources/coding-tools-mcp/scripts/reconcile_exact_stale_run.py",
        "to": "resources/coding-tools-mcp/scripts/reconcile_exact_stale_run.py"
      }
    ],
    "afterPack": "scripts/verify-packaged-resources.js",
    "win": {
      "icon": "electron/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Coding Tools MCP",
      "installerIcon": "electron/app-icon.ico",
      "uninstallerIcon": "electron/app-icon.ico",
      "installerHeaderIcon": "electron/app-icon.ico",
      "runAfterFinish": true
    }
  }
}
