# Build artifacts
/target
node_modules/
**/node_modules/
dist/
**/dist/
build/
out/
.electron-builder-cache/
Tools-Codex-web/

# Excel & Spreadsheet files
*.xlsx
*.xls
*.xlsm
*.xlsb
*.csv
*.ods

# Accounts & local data
ACC/
data*

# Python test caches
__pycache__/
**/__pycache__/
*.pyc

# Local Codex CLI workspace
.codex
.claude
# Generated patch files
*.patch

# Workspace-local Coding Tools runtime state.
# Includes task/history state, performance traces, EOCL ledger/reports,
# temporary probes, and automation worktrees. Keep it local and back it up
# separately only when migrating unfinished work or preserving research data.
/.coding-tools/
/ci-windows-fix2/

# Frontend dependencies
/frontend/node_modules

# Local sensitive deployment config — NEVER commit these.
# They contain real server URLs, tokens, and host paths. If a token was ever
# committed or exposed, rotate WEBCODEX_TOKEN immediately.
/.env
/agent.toml
/projects.d/
/*.local.toml
/webcodex.env

# Generated publish-ready npm manifest. Release checksums are created on OE
# after all native artifacts exist; only manifest.example.json is source-controlled.
/npm/webcodex/manifest.json

# Generated documentation output (explicit rules, so docs/ stays tracked).
/docs-generated/
/docs-tmp/
/site/

# Local-only documentation archive for notes intentionally removed from git.
/docs-local-archive/
/ignore/

# Watched frontend development output.
/frontend/.dev-dist/

